# Finales de línea fijos: los .bat necesitan CRLF y los scripts de bash y los parches, LF.
# Sin esto, un clon en Windows con core.autocrlf=true los cambia y el instalador falla.
* text=auto
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf
*.py    text eol=lf
*.patch text eol=lf
*.toml  text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.bin   binary
*.ico   binary
*.gba   binary
