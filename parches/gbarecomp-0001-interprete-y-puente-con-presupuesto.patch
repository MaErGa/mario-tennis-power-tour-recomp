         return;
     }
-    runtime_bridge_interpret(entry_pc, entry_thumb, /*forced_stop_pc=*/0u,
-                             /*max_instrs=*/0u);
+    runtime_bridge_interpret_anidado(entry_pc, entry_thumb);
 }
 
