+// PARCHE mario-tennis: puente con presupuesto cuando está anidado.
+//
+// Con la pila de retornos vacía, el puente cura a nativo en cuanto llega a una
+// entrada estática, así que termina siempre. Anidado (hay un llamante generado
+// esperando), el puente solo para al llegar a la dirección de retorno del
+// llamante. Si el código «vuelve» por otro camino (reanudación de una tarea,
+// cambio de pila) esa dirección no llega nunca y el puente acaba interpretando
+// TODO el juego, con las funciones de ROM incluidas, sin presentar fotogramas y
+// hasta abortar a los 200 M de instrucciones.
+//
+// Con presupuesto: si se agota, el PC queda donde está y devuelve 0. Los
+// llamantes generados ven R15 != su dirección de retorno, cancelan sus retornos
+// y desenrollan hasta el bucle principal, que sigue desde ese PC con la pila
+// vacía (el puente ya cura a nativo allí).
+extern "C" int runtime_bridge_interpret_anidado(uint32_t entry_pc,
+                                                bool entry_thumb) {
+    static const std::uint64_t kPresupuesto = [] {
+        const char* e = std::getenv("GBARECOMP_NESTED_BRIDGE_BUDGET");
+        return (e && *e) ? std::strtoull(e, nullptr, 10)
+                         : static_cast<std::uint64_t>(1000000u);
+    }();
+    const bool anidado = runtime_call_stack_depth() != 0u &&
+                         g_irq_nest_depth == 0u && kPresupuesto != 0u;
+    return runtime_bridge_interpret(entry_pc, entry_thumb, /*forced_stop_pc=*/0u,
+                                    /*max_instrs=*/anidado ? kPresupuesto : 0u);
+}
+
 // runtime_dispatch_miss — Stage-1 self-healing entry: log the miss, enqueue a
 // Stage-2 heal (so the NEXT hit dispatches native), then bridge through the
 // interpreter via runtime_bridge_interpret. See that function's note above.
