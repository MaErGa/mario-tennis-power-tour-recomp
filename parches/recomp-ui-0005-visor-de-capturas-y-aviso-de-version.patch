+// PARCHE mario-tennis: miniatura (ver launcher_gl.h).
+LauncherTexture launcher_texture_load_thumb(const char* path, int max_w, int max_h,
+                                            int* out_w, int* out_h) {
+    LauncherTexture t = { 0, 0, 0 };
+    int w = 0, h = 0, comp = 0;
+    unsigned char* pixels = stbi_load(path, &w, &h, &comp, 4);   // RGBA
+    if (!pixels) return t;
+    if (out_w) *out_w = w;
+    if (out_h) *out_h = h;
+    if (w <= 0 || h <= 0 || max_w <= 0 || max_h <= 0) { stbi_image_free(pixels); return t; }
+
+    int k = 1;
+    while (w / k > max_w || h / k > max_h) ++k;
+    const int tw = w / k > 0 ? w / k : 1;
+    const int th = h / k > 0 ? h / k : 1;
+    unsigned char* mini = (unsigned char*)malloc((size_t)tw * th * 4);
+    if (!mini) { stbi_image_free(pixels); return t; }
+    for (int y = 0; y < th; ++y) {
+        for (int x = 0; x < tw; ++x) {
+            unsigned int suma[4] = { 0, 0, 0, 0 };
+            for (int dy = 0; dy < k; ++dy) {
+                const unsigned char* fila = pixels + ((size_t)(y * k + dy) * w + (size_t)x * k) * 4;
+                for (int dx = 0; dx < k; ++dx)
+                    for (int c = 0; c < 4; ++c) suma[c] += fila[dx * 4 + c];
+            }
