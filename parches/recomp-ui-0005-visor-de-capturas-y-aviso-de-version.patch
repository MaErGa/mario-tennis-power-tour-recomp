+// ═══ PARCHE mario-tennis: visor de capturas ═══════════════════════════════════════
+// Pantalla «Capturas» del menú de arranque: rejilla de miniaturas con las imágenes de la
+// carpeta «capturas» (las que guarda la tecla de captura, F10 por defecto) y, al elegir una,
+// vista grande con anterior / siguiente / abrir carpeta / borrar. Las miniaturas se cargan de
+// dos en dos por fotograma y solo las que se ven; todo se libera al salir de la pantalla.
+namespace capturas {
+
+struct Foto {
+    std::string ruta;
+    std::string nombre;
+    LauncherTexture mini{};   // miniatura (id 0 = sin cargar)
+    int ancho = 0, alto = 0;  // tamaño real de la imagen
+    bool intentada = false;   // ya se intentó cargar la miniatura (no reintentar cada fotograma)
+};
+
+constexpr size_t kMaximo = 150;        // las más recientes
+std::vector<Foto> g_fotos;
+bool g_listado = false;
+int g_abierta = -1;                    // captura en vista grande; -1 = rejilla
+int g_borrar = -1;                     // captura «armada» para borrar (hay que pulsar dos veces)
+LauncherTexture g_grande{};
+int g_grande_de = -1;                  // de qué captura es g_grande
+const char* g_mensaje = nullptr;       // aviso de estado (ya traducido)
+
+std::filesystem::path carpeta() {
+    const char* ini = std::getenv("MTP_CONFIG_INI");
+    std::filesystem::path base =
+        (ini && ini[0]) ? std::filesystem::path(ini).parent_path() : std::filesystem::path();
+    if (base.empty()) base = ".";
+    return base / "capturas";
+}
+
+void liberar() {
+    for (Foto& f : g_fotos) launcher_texture_free(&f.mini);
+    g_fotos.clear();
+    launcher_texture_free(&g_grande);
+    g_grande_de = -1;
+    g_abierta = -1;
+    g_borrar = -1;
+    g_mensaje = nullptr;
+    g_listado = false;
+}
+
+void listar() {
+    liberar();
+    std::error_code ec;
+    for (std::filesystem::directory_iterator it(carpeta(), ec), fin; !ec && it != fin; it.increment(ec)) {
+        std::error_code e2;
+        if (!it->is_regular_file(e2)) continue;
+        std::string ext = it->path().extension().string();
+        for (char& c : ext) c = (char)std::tolower((unsigned char)c);
+        if (ext != ".png") continue;
+        Foto f;
+        f.ruta = it->path().string();
+        f.nombre = it->path().filename().string();
+        g_fotos.push_back(std::move(f));
+    }
+    // Los nombres llevan la fecha y la hora (MarioTennis_2026-11-14_17-32-05.png): al
+    // ordenarlos al revés quedan primero las más recientes.
+    std::sort(g_fotos.begin(), g_fotos.end(),
+              [](const Foto& a, const Foto& b) { return a.nombre > b.nombre; });
+    if (g_fotos.size() > kMaximo) g_fotos.resize(kMaximo);
+    g_listado = true;
+}
+
+// «MarioTennis_2026-11-14_17-32-05.png» -> «14/11/2026  17:32:05»; si no encaja, el nombre.
+std::string etiqueta(const Foto& f) {
+    int a = 0, mes = 0, d = 0, h = 0, mi = 0, s = 0;
+    if (std::sscanf(f.nombre.c_str(), "MarioTennis_%d-%d-%d_%d-%d-%d", &a, &mes, &d, &h, &mi, &s) == 6) {
+        char buf[48];
+        std::snprintf(buf, sizeof(buf), "%02d/%02d/%04d  %02d:%02d:%02d", d, mes, a, h, mi, s);
+        return buf;
+    }
+    return f.nombre;
+}
+
+void abrir_carpeta() {
+    std::error_code ec;
+    std::filesystem::create_directories(carpeta(), ec);
+    std::string url, error;
+    if (launcher_directory_url(carpeta().u8string().c_str(), url, error)) (void)SDL_OpenURL(url.c_str());
+}
+
+void borrar(int i) {
+    if (i < 0 || i >= (int)g_fotos.size()) return;
+    std::error_code ec;
+    const bool ok = std::filesystem::remove(g_fotos[i].ruta, ec) && !ec;
+    if (!ok) { g_mensaje = ui_text("Could not delete the screenshot."); return; }
+    launcher_texture_free(&g_fotos[i].mini);
+    g_fotos.erase(g_fotos.begin() + i);
+    launcher_texture_free(&g_grande);
+    g_grande_de = -1;
+    g_borrar = -1;
+    g_mensaje = ui_text("Screenshot deleted.");
+    if (g_fotos.empty()) g_abierta = -1;
+    else if (g_abierta >= (int)g_fotos.size()) g_abierta = (int)g_fotos.size() - 1;
+}
+
+}  // namespace capturas
+
+void draw_capturas(LauncherModel* m, const LauncherTheme& th) {
+    (void)m;
+    using namespace capturas;
+    if (!g_listado) listar();
+    const float alto_cuerpo = ImGui::GetContentRegionAvail().y;
+    const float arriba_y = ImGui::GetCursorScreenPos().y;   // para repartir la altura entre botones e imagen
+    if (!begin_panel("capturas_page", 0, false)) {
+        end_panel();
+        return;
+    }
+    eyebrow("SCREENSHOTS");
+    const float sep = px(12.0f);
+
+    // Barra superior de la rejilla: recuento / aviso y «Abrir carpeta» (en la vista grande,
+    // el botón va en la fila de botones para dejar más sitio a la imagen).
+    if (g_abierta < 0) {
+        ImGui::AlignTextToFramePadding();
+        if (g_mensaje) ImGui::TextColored(col(th.good), "%s", g_mensaje);
+        else if (g_fotos.empty()) ImGui::TextColored(col(th.text_muted), "%s",
+            ui_text("No screenshots yet. Press the screenshot key (F10 by default) while you play to take one."));
+        else ImGui::TextColored(col(th.text_muted), ui_text("Saved screenshots: %d"), (int)g_fotos.size());
+        const float w = px(150.0f);
+        ImGui::SameLine(ImGui::GetWindowContentRegionMax().x - w);
+        if (ImGui::Button(ui_text("Open folder"), ImVec2(w, px(30)))) abrir_carpeta();
+        ImGui::Dummy(ImVec2(0, px(6.0f)));
+    }
+
+    if (g_abierta < 0) {
+        // ── Rejilla de miniaturas ──────────────────────────────────────────────
+        const float mw = px(250.0f), mh = px(167.0f);   // 3:2, como la imagen del juego
+        int cols = (int)((ImGui::GetContentRegionAvail().x + sep) / (mw + sep));
+        if (cols < 1) cols = 1;
+        int presupuesto = 2;                             // miniaturas que se cargan en este fotograma
+        for (int i = 0; i < (int)g_fotos.size(); ++i) {
+            Foto& f = g_fotos[i];
+            if (i % cols != 0) ImGui::SameLine(0, sep);
+            ImGui::BeginGroup();
+            ImGui::PushID(i);
+            const ImVec2 p0 = ImGui::GetCursorScreenPos();
+            const ImVec2 p1(p0.x + mw, p0.y + mh);
+            // EnableNav: InvisibleButton no se deja alcanzar con flechas/mando si no se pide.
+            const bool pulsada = ImGui::InvisibleButton("##foto", ImVec2(mw, mh), ImGuiButtonFlags_EnableNav);
+            const bool resaltada = ImGui::IsItemHovered() || ImGui::IsItemFocused();
+            ImDrawList* dl = ImGui::GetWindowDrawList();
+            dl->AddRectFilled(p0, p1, imcol(th.control), px(4.0f));
+            if (!f.mini.id && !f.intentada && presupuesto > 0 && ImGui::IsRectVisible(p0, p1)) {
+                f.mini = launcher_texture_load_thumb(f.ruta.c_str(), 360, 240, &f.ancho, &f.alto);
+                f.intentada = true;
+                --presupuesto;
+            }
+            if (f.mini.id && f.mini.w > 0 && f.mini.h > 0) {
+                const float s = std::min(mw / (float)f.mini.w, mh / (float)f.mini.h);
+                const float w = f.mini.w * s, h = f.mini.h * s;
+                const ImVec2 a(p0.x + (mw - w) * 0.5f, p0.y + (mh - h) * 0.5f);
+                dl->AddImage(tid(f.mini), a, ImVec2(a.x + w, a.y + h));
+            } else if (f.intentada) {
+                const char* x = ui_text("Could not read this image.");
+                const ImVec2 ts = ImGui::CalcTextSize(x);
+                dl->AddText(ImVec2(p0.x + (mw - ts.x) * 0.5f, p0.y + (mh - ts.y) * 0.5f),
+                            imcol(th.text_muted), x);
+            }
+            dl->AddRect(p0, p1, resaltada ? imcol(th.accent) : imcol(th.border), px(4.0f), 0,
+                        px(resaltada ? 2.0f : 1.0f));
+            ImGui::TextColored(col(th.text_muted), "%s", etiqueta(f).c_str());
+            ImGui::PopID();
+            ImGui::EndGroup();
+            if (pulsada) { g_abierta = i; g_borrar = -1; g_mensaje = nullptr; }
+        }
+    } else {
+        // ── Vista grande ───────────────────────────────────────────────────────
+        if (g_abierta >= (int)g_fotos.size()) g_abierta = (int)g_fotos.size() - 1;
+        if (g_abierta < 0) { end_panel(); return; }
+        Foto& f = g_fotos[g_abierta];
+        if (g_grande_de != g_abierta) {
+            launcher_texture_free(&g_grande);
+            g_grande = launcher_texture_load(f.ruta.c_str());
+            g_grande_de = g_abierta;
+        }
+        ImGui::TextColored(col(th.text), "%s", etiqueta(f).c_str());
+        ImGui::SameLine(0, px(14.0f));
+        ImGui::TextColored(col(th.text_muted), "%s", f.nombre.c_str());
+        if (g_grande.id) {
+            ImGui::SameLine(0, px(14.0f));
+            ImGui::TextColored(col(th.text_muted), "%d x %d", g_grande.w, g_grande.h);
+        }
+        if (g_mensaje) {
+            ImGui::SameLine(0, px(14.0f));
+            ImGui::TextColored(col(th.good), "%s", g_mensaje);
+        }
+        const float bw = px(130.0f), bh = px(34.0f);
+        const bool hay_anterior = g_abierta > 0;
+        const bool hay_siguiente = g_abierta + 1 < (int)g_fotos.size();
+        ImGui::BeginDisabled(!hay_anterior);
+        if (ImGui::Button(ui_text("< Previous"), ImVec2(bw, bh))) { --g_abierta; g_borrar = -1; g_mensaje = nullptr; }
+        ImGui::EndDisabled();
+        ImGui::SameLine(0, px(8.0f));
+        ImGui::BeginDisabled(!hay_siguiente);
+        if (ImGui::Button(ui_text("Next >"), ImVec2(bw, bh))) { ++g_abierta; g_borrar = -1; g_mensaje = nullptr; }
+        ImGui::EndDisabled();
+        ImGui::SameLine(0, px(8.0f));
+        ImGui::TextColored(col(th.text_muted), ui_text("%d of %d"), g_abierta + 1, (int)g_fotos.size());
+        ImGui::SameLine(0, px(8.0f));
+        {
+            const bool armado = (g_borrar == g_abierta);
+            const float w2 = px(170.0f);
+            ImGui::SameLine(ImGui::GetWindowContentRegionMax().x - 3 * w2 - 2 * px(8.0f));
+            if (ImGui::Button(ui_text("Open folder"), ImVec2(w2, bh))) abrir_carpeta();
+            ImGui::SameLine(0, px(8.0f));
+            if (armado) ImGui::PushStyleColor(ImGuiCol_Text, col(th.warn));
+            if (ImGui::Button(armado ? ui_text("Delete? Press again") : ui_text("Delete"), ImVec2(w2, bh))) {
+                if (armado) borrar(g_abierta);
+                else { g_borrar = g_abierta; g_mensaje = nullptr; }
+            }
+            if (armado) ImGui::PopStyleColor();
+            ImGui::SameLine(0, px(8.0f));
+            if (ImGui::Button(ui_text("Close"), ImVec2(w2, bh))) { g_abierta = -1; g_borrar = -1; }
+        }
+        ImGui::Dummy(ImVec2(0, px(8.0f)));
+        if (g_abierta >= 0 && g_grande_de == g_abierta) {
+            if (g_grande.id && g_grande.w > 0 && g_grande.h > 0) {
+                // Lo que queda del cuerpo de la pantalla tras la cabecera y los botones.
+                float caja_h = alto_cuerpo - (ImGui::GetCursorScreenPos().y - arriba_y) - px(28.0f);
+                if (caja_h < px(160.0f)) caja_h = px(160.0f);
+                const float caja_w = ImGui::GetContentRegionAvail().x;
+                const float s = std::min(caja_w / (float)g_grande.w, caja_h / (float)g_grande.h);
+                const float w = g_grande.w * s, h = g_grande.h * s;
+                ImGui::SetCursorPosX(ImGui::GetCursorPosX() + (caja_w - w) * 0.5f);
+                ImGui::Image(tid(g_grande), ImVec2(w, h));
+            } else {
+                ImGui::TextColored(col(th.warn), "%s", ui_text("Could not read this image."));
+            }
+        }
+    }
+    end_panel();
+}
