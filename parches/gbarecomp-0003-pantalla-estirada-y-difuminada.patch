+// PARCHE mario-tennis: modo de presentación de la imagen de 240x160, leído una
+// vez de GBARECOMP_STRETCH (el anfitrión del juego la fija según el menú):
+// 0 = barras negras (original), 1 = estirada a la ventana, 2 = barras rellenas.
+static int mtp_modo_ventana() {
+    static const int modo = [] {
+        const char* e = std::getenv("GBARECOMP_STRETCH");
+        if (!e || !e[0] || e[0] == '0') return 0;
+        return e[0] == '2' ? 2 : 1;
+    }();
+    return modo;
+}
+
+// PARCHE mario-tennis: fondo de las barras laterales (modo 2). Reduce la imagen
+// dos veces (÷4 y ÷4) con filtro lineal para obtener un fondo muy suave: así las
+// barras no repiten, como un fantasma, el marcador ni los personajes. Devuelve la
+// textura que hay que estirar a la ventana; si el renderer no admite destinos de
+// dibujo, la propia imagen (menos suave pero igualmente válida).
+static SDL_Texture* mtp_fondo_difuminado(Backend* b) {
+    if (!b->mtp_relleno) return nullptr;
+    if (b->mtp_reducida_fallo) return b->mtp_relleno;
+    if (!b->mtp_reducida_a || !b->mtp_reducida_b) {
+        auto crear = [&](int w, int h) -> SDL_Texture* {
+            SDL_Texture* t = SDL_CreateTexture(
+                b->renderer, SDL_PIXELFORMAT_RGBA8888, SDL_TEXTUREACCESS_TARGET, w, h);
+            if (t) {
+                SDL_SetTextureBlendMode(t, SDL_BLENDMODE_NONE);
+#if SDL_VERSION_ATLEAST(2, 0, 12)
+                SDL_SetTextureScaleMode(t, SDL_ScaleModeLinear);
+#endif
+            }
+            return t;
+        };
+        b->mtp_reducida_a = crear(b->base_w / 4, b->base_h / 4);
+        b->mtp_reducida_b = crear(b->base_w / 16 + 1, b->base_h / 16 + 1);
+        if (!b->mtp_reducida_a || !b->mtp_reducida_b) {
+            if (b->mtp_reducida_a) SDL_DestroyTexture(b->mtp_reducida_a);
+            if (b->mtp_reducida_b) SDL_DestroyTexture(b->mtp_reducida_b);
+            b->mtp_reducida_a = b->mtp_reducida_b = nullptr;
+            b->mtp_reducida_fallo = true;
+            return b->mtp_relleno;
+        }
+    }
+    SDL_Texture* previo = SDL_GetRenderTarget(b->renderer);
+    SDL_SetTextureColorMod(b->mtp_relleno, 255, 255, 255);
+    const bool ok =
+        SDL_SetRenderTarget(b->renderer, b->mtp_reducida_a) == 0 &&
+        SDL_RenderCopy(b->renderer, b->mtp_relleno, nullptr, nullptr) == 0 &&
+        SDL_SetRenderTarget(b->renderer, b->mtp_reducida_b) == 0 &&
+        SDL_RenderCopy(b->renderer, b->mtp_reducida_a, nullptr, nullptr) == 0;
+    SDL_SetRenderTarget(b->renderer, previo);
+    return ok ? b->mtp_reducida_b : b->mtp_relleno;
+}
