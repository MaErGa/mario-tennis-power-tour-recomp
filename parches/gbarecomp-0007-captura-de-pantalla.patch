+// PARCHE mario-tennis: captura de pantalla (tecla Screenshot, F10 por defecto). Guarda
+// la imagen del juego, sin filtros ni marcos y ampliada con vecino más cercano, como PNG
+// en «capturas» junto a config.ini. Se hace en el siguiente fotograma que se dibuje.
+bool g_mtp_captura_pendiente = false;
+
+void mtp_captura_si_toca(HostWindow& win, const uint8_t* rgb, uint32_t w, uint32_t h) {
+    if (!g_mtp_captura_pendiente) return;
+    g_mtp_captura_pendiente = false;
+    if (!rgb || w == 0 || h == 0) return;
+    std::error_code ec;
+    const char* base = win.config_dir();
+    std::filesystem::path dir = std::filesystem::path(base && *base ? base : ".") / "capturas";
+    std::filesystem::create_directories(dir, ec);
+    char marca[64];
+    const std::time_t ahora = std::time(nullptr);
+    std::strftime(marca, sizeof(marca), "%Y-%m-%d_%H-%M-%S", std::localtime(&ahora));
+    std::filesystem::path ruta = dir / (std::string("MarioTennis_") + marca + ".png");
+    for (int n = 2; std::filesystem::exists(ruta, ec) && n < 1000; ++n)
+        ruta = dir / (std::string("MarioTennis_") + marca + "_" + std::to_string(n) + ".png");
+    // Entero para llegar a unos 720 px de alto como mínimo (240x160 -> x5 = 1200x800).
+    const uint32_t k = std::max<uint32_t>(1, (720 + h - 1) / h);
+    std::vector<uint8_t> grande(static_cast<std::size_t>(w) * k * h * k * 3);
+    for (uint32_t y = 0; y < h * k; ++y) {
+        const uint8_t* fila = rgb + static_cast<std::size_t>(y / k) * w * 3;
+        uint8_t* dst = grande.data() + static_cast<std::size_t>(y) * w * k * 3;
+        for (uint32_t x = 0; x < w * k; ++x) {
+            const uint8_t* px = fila + static_cast<std::size_t>(x / k) * 3;
+            dst[x * 3 + 0] = px[0];
+            dst[x * 3 + 1] = px[1];
+            dst[x * 3 + 2] = px[2];
+        }
+    }
+    if (write_png(ruta.string(), grande.data(), w * k, h * k)) {
+        std::fprintf(stderr, "captura guardada: %s\n", ruta.string().c_str());
+        win.announce("captura guardada en la carpeta capturas");
+    } else {
+        std::fprintf(stderr, "captura: no se pudo escribir %s\n", ruta.string().c_str());
+        win.announce("no se pudo guardar la captura");
+    }
+}
