+// PARCHE mario-tennis: partidas de otros emuladores y de flashcarts. Un .sav de SRAM
+// de la GBA mide 32 KiB, pero algunos programas lo guardan rellenado hasta 64 o 128
+// KiB (con 0x00, con 0xFF o repitiendo los mismos 32 KiB). Si lo que sobra es solo
+// eso, se recorta a 'tam' y devuelve true; si hay datos distintos (otro tipo de
+// guardado, otro juego) no toca nada y devuelve false.
+bool mtp_recortar_sav(std::vector<uint8_t>* datos, std::size_t tam) {
+    if (!datos || tam == 0 || datos->size() <= tam) return false;
+    const uint8_t* resto = datos->data() + tam;
+    const std::size_t n = datos->size() - tam;
+    bool relleno = (resto[0] == 0x00 || resto[0] == 0xFF);
+    for (std::size_t i = 1; relleno && i < n; ++i) relleno = (resto[i] == resto[0]);
+    bool espejo = (datos->size() % tam) == 0;
+    for (std::size_t i = 0; espejo && i < n; ++i) espejo = (resto[i] == (*datos)[i % tam]);
+    if (!relleno && !espejo) return false;
+    datos->resize(tam);
+    return true;
+}
