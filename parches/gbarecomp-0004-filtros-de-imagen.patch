+void HostWindow::set_image_filter(int filtro, bool anunciar) {
+    if (!open_ || !impl_) return;
+    auto* b = static_cast<Backend*>(impl_);
+    if (filtro < 0 || filtro >= mtp_filtros::kTotal) filtro = 0;
+    g_mtp_filtro = filtro;
+    set_linear_filter(filtro == mtp_filtros::kLinear);
+    b->mtp_masc_filtro = -1;   // fuerza a rehacer la máscara
+    std::fprintf(stderr, "host_window: filtro de imagen %d (%s)\n", filtro,
+                 mtp_filtros::nombre(filtro));
+    if (anunciar) {
+        mtp_guardar_filtro(b->mtp_config_dir, filtro);
+        const std::string texto = b->title + " - filtro: " + mtp_filtros::nombre(filtro);
+        SDL_SetWindowTitle(b->window, texto.c_str());
+        b->mtp_aviso_hasta = SDL_GetTicks() + 3000u;
+        if (b->mtp_aviso_hasta == 0) b->mtp_aviso_hasta = 1;
+    }
+}
