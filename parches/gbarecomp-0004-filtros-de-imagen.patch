+// PARCHE mario-tennis: guarda el filtro elegido en config.ini (image_filter, y de paso
+// linear_filter / sharp_filter, que el menú de arranque mantiene a juego). Solo toca las
+// líneas que ya existen; si no hay config.ini no hace nada.
+static void mtp_guardar_filtro(const std::string& dir, int filtro) {
+    if (dir.empty()) return;
+    const std::string ruta = dir + "/config.ini";
+    std::FILE* f = std::fopen(ruta.c_str(), "rb");
+    if (!f) return;
+    std::string contenido;
+    char buf[4096];
+    std::size_t n;
+    while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) contenido.append(buf, n);
+    std::fclose(f);
+    const struct { const char* clave; int valor; } cambios[] = {
+        {"image_filter", filtro},
+        {"linear_filter", filtro == mtp_filtros::kLinear ? 1 : 0},
+        {"sharp_filter", filtro == mtp_filtros::kNitido ? 1 : 0},
+    };
+    std::string salida;
+    std::size_t pos = 0;
+    bool cambiado = false;
+    while (pos < contenido.size()) {
+        std::size_t fin = contenido.find('\n', pos);
+        const bool hay_salto = fin != std::string::npos;
+        if (!hay_salto) fin = contenido.size();
+        std::string linea = contenido.substr(pos, fin - pos);
+        const bool cr = !linea.empty() && linea.back() == '\r';
+        if (cr) linea.pop_back();
+        for (const auto& c : cambios) {
+            const std::size_t lc = std::strlen(c.clave);
+            if (linea.compare(0, lc, c.clave) == 0) {
+                std::size_t k = lc;
+                while (k < linea.size() && (linea[k] == ' ' || linea[k] == '\t')) ++k;
+                if (k < linea.size() && linea[k] == '=') {
+                    linea = std::string(c.clave) + " = " + std::to_string(c.valor);
+                    cambiado = true;
+                }
+                break;
+            }
+        }
+        salida += linea;
+        if (cr) salida += '\r';
+        if (hay_salto) salida += '\n';
+        pos = fin + (hay_salto ? 1 : 0);
+    }
+    if (!cambiado) return;
+    const std::string tmp = ruta + ".tmp";
+    std::FILE* o = std::fopen(tmp.c_str(), "wb");
+    if (!o) return;
+    const bool ok = std::fwrite(salida.data(), 1, salida.size(), o) == salida.size();
+    std::fclose(o);
+    if (!ok || std::rename(tmp.c_str(), ruta.c_str()) != 0) {
+        std::remove(ruta.c_str());
+        if (std::rename(tmp.c_str(), ruta.c_str()) != 0) std::remove(tmp.c_str());
+    }
+}
