+// ── INICIO filtros de imagen (PARCHE mario-tennis) ─────────────────────────────
+// Filtros de imagen sobre el fotograma ya terminado (240x160). Solo actúan al
+// presentar: no tocan la emulación ni el fotograma de verificación.
+//
+// Los valores son los índices del selector «Filtro de imagen» del menú:
+//   0 Nearest   1 Linear                          (los hace SDL, sin filtro propio)
+//   2 Sharp fractional                            (ampliación entera + ajuste lineal)
+//   3 Scale2x   4 Scale3x   5 Scale4x             (AdvMAME: suavizan diagonales y
+//                                                  no emborronan el texto)
+//   6 HD smooth                                   (Scale4x + suavizado muy ligero)
+//   7 LCD grid  8 CRT scanlines                   (base «nítida» + MÁSCARA a la
+//                                                  resolución de la ventana)
+//
+// Dos ideas para que no se vea «solo borroso» en una ventana cualquiera:
+//  - Los ampliadores (3..6) generan una imagen N veces mayor y después se replica
+//    un número entero de veces más (factor_post) para que el último ajuste lineal
+//    de la tarjeta gráfica sea pequeño: los bordes siguen nítidos.
+//  - La rejilla LCD y las líneas CRT no se pintan sobre la imagen ampliada (al
+//    estirarla a la ventana se emborronaban): se calculan como una máscara del
+//    tamaño exacto de la imagen en pantalla y se multiplican por encima (mezcla
+//    MOD de SDL), así la rejilla/líneas quedan nítidas a cualquier tamaño.
+namespace mtp_filtros {
+
+enum : int {
+    kNearest = 0, kLinear = 1, kNitido = 2, kScale2x = 3, kScale3x = 4,
+    kScale4x = 5, kHdSuave = 6, kRejillaLcd = 7, kCrt = 8, kTotal = 9
+};
+
+// Cuántas veces mayor es la imagen que genera el ampliador (0 = no genera nada).
+// Los filtros «nítidos» (2, 7 y 8) dependen del tamaño de la ventana: «factor_nitido».
+inline int factor(int filtro) {
+    switch (filtro) {
+        case kScale2x:                    return 2;
+        case kScale3x:                    return 3;
+        case kScale4x: case kHdSuave:     return 4;
+        default:                          return 0;
+    }
+}
+
+// «Sharp fractional»: se amplía cada píxel un número entero de veces (el mayor
+// que cabe en la ventana, con un tope) y la tarjeta gráfica hace el último
+// ajuste con filtro lineal. Con ventana de tamaño entero queda perfectamente
+// nítido; con tamaño fraccionario, sin píxeles de anchos desiguales.
+inline int factor_nitido(int ancho_ventana, int ancho_base) {
+    if (ancho_base < 1) return 0;
+    const int n = ancho_ventana / ancho_base;
+    if (n < 2) return 0;
+    return n > 6 ? 6 : n;
+}
+
+// Los filtros 7 y 8 pintan sobre la base nítida una máscara a la resolución de la ventana.
+inline bool usa_mascara(int filtro) { return filtro == kRejillaLcd || filtro == kCrt; }
+
+// Los filtros cuya base es la ampliación entera nítida (la de «factor_nitido»).
+inline bool es_nitido(int filtro) {
+    return filtro == kNitido || filtro == kRejillaLcd || filtro == kCrt;
+}
+
+// Cuántas veces más se replica la imagen de un ampliador (3..6) para que el ajuste
+// lineal final sea pequeño (1 = nada). Tope: 4 veces y 2048 píxeles de ancho.
+inline int factor_post(int ancho_pantalla, int ancho_salida) {
+    if (ancho_salida < 1 || ancho_pantalla < 1) return 1;
+    int k = ancho_pantalla / ancho_salida;
+    if (k > 4) k = 4;
+    while (k > 1 && ancho_salida * k > 2048) --k;
+    return k < 1 ? 1 : k;
+}
+
+// Factor total (imagen generada / 240x160) de un filtro con esos parámetros.
+inline int escala_total(int filtro, int n_nitido, int k_post) {
+    if (es_nitido(filtro)) return n_nitido;
+    const int n = factor(filtro);
+    return n * (k_post < 1 ? 1 : k_post);
+}
+
+struct Buffers {
+    std::vector<uint32_t> t1, t2;   // intermedios (se reutilizan entre fotogramas)
+};
+
+namespace detalle {
+
+inline uint32_t en(const uint32_t* s, int w, int h, int x, int y) {
+    x = x < 0 ? 0 : (x >= w ? w - 1 : x);
+    y = y < 0 ? 0 : (y >= h ? h - 1 : y);
+    return s[static_cast<std::size_t>(y) * w + x];
+}
+
+inline int cr(uint32_t p) { return static_cast<int>((p >> 16) & 0xFF); }
+inline int cg(uint32_t p) { return static_cast<int>((p >> 8) & 0xFF); }
+inline int cb(uint32_t p) { return static_cast<int>(p & 0xFF); }
+inline uint32_t rgb(int r, int g, int b) {
+    r = r < 0 ? 0 : (r > 255 ? 255 : r);
+    g = g < 0 ? 0 : (g > 255 ? 255 : g);
+    b = b < 0 ? 0 : (b > 255 ? 255 : b);
+    return 0xFF000000u | (static_cast<uint32_t>(r) << 16) |
+           (static_cast<uint32_t>(g) << 8) | static_cast<uint32_t>(b);
+}
+
+// Ampliación entera sin suavizar (para el filtro nítido).
+inline void replicar(const uint32_t* s, int w, int h, int n, uint32_t* d) {
+    const std::size_t dw = static_cast<std::size_t>(w) * n;
+    for (int y = 0; y < h; ++y) {
+        uint32_t* fila = d + static_cast<std::size_t>(y) * n * dw;
+        for (int x = 0; x < w; ++x) {
+            const uint32_t p = s[static_cast<std::size_t>(y) * w + x];
+            for (int i = 0; i < n; ++i) fila[static_cast<std::size_t>(x) * n + i] = p;
+        }
+        for (int j = 1; j < n; ++j)
+            std::memcpy(fila + j * dw, fila, dw * sizeof(uint32_t));
+    }
+}
+
+// Scale2x / AdvMAME2x: cada píxel E pasa a 2x2; un vecino solo "invade" si dos
+// vecinos contiguos coinciden y los otros dos difieren (así no hay falsos bordes).
+inline void scale2x(const uint32_t* s, int w, int h, uint32_t* d) {
+    const std::size_t dw = static_cast<std::size_t>(w) * 2;
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            const uint32_t E = s[static_cast<std::size_t>(y) * w + x];
+            const uint32_t B = en(s, w, h, x, y - 1), D = en(s, w, h, x - 1, y);
+            const uint32_t F = en(s, w, h, x + 1, y), H = en(s, w, h, x, y + 1);
+            uint32_t e0 = E, e1 = E, e2 = E, e3 = E;
+            if (B != H && D != F) {
+                e0 = (D == B) ? D : E;
+                e1 = (B == F) ? F : E;
+                e2 = (D == H) ? D : E;
+                e3 = (H == F) ? F : E;
+            }
+            uint32_t* f0 = d + static_cast<std::size_t>(y) * 2 * dw + static_cast<std::size_t>(x) * 2;
+            f0[0] = e0; f0[1] = e1; f0[dw] = e2; f0[dw + 1] = e3;
+        }
+    }
+}
+
+// Scale3x / AdvMAME3x: igual, a 3x3.
+inline void scale3x(const uint32_t* s, int w, int h, uint32_t* d) {
+    const std::size_t dw = static_cast<std::size_t>(w) * 3;
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            const uint32_t A = en(s, w, h, x - 1, y - 1), B = en(s, w, h, x, y - 1), C = en(s, w, h, x + 1, y - 1);
+            const uint32_t D = en(s, w, h, x - 1, y),     E = en(s, w, h, x, y),     F = en(s, w, h, x + 1, y);
+            const uint32_t G = en(s, w, h, x - 1, y + 1), H = en(s, w, h, x, y + 1), I = en(s, w, h, x + 1, y + 1);
+            uint32_t p[9] = {E, E, E, E, E, E, E, E, E};
+            if (B != H && D != F) {
+                p[0] = (D == B) ? D : E;
+                p[1] = ((D == B && E != C) || (B == F && E != A)) ? B : E;
+                p[2] = (B == F) ? F : E;
+                p[3] = ((D == B && E != G) || (D == H && E != A)) ? D : E;
+                p[4] = E;
+                p[5] = ((B == F && E != I) || (H == F && E != C)) ? F : E;
+                p[6] = (D == H) ? D : E;
+                p[7] = ((D == H && E != I) || (H == F && E != G)) ? H : E;
+                p[8] = (H == F) ? F : E;
+            }
+            uint32_t* f0 = d + static_cast<std::size_t>(y) * 3 * dw + static_cast<std::size_t>(x) * 3;
+            for (int j = 0; j < 3; ++j)
+                for (int i = 0; i < 3; ++i) f0[static_cast<std::size_t>(j) * dw + i] = p[j * 3 + i];
+        }
+    }
+}
+
+// Mezcla [1 6 1]/8 (redondeada) de tres píxeles, con aritmética empaquetada: rojo y
+// azul juntos en una palabra de 16 bits por canal, verde aparte. Cada vecino pesa solo
+// el 12,5 %: redondea los escalones de las diagonales sin emborronar.
+inline uint32_t mezcla161(uint32_t a, uint32_t b, uint32_t c) {
+    const uint32_t rb = (((a & 0x00FF00FFu) + (b & 0x00FF00FFu) * 6u + (c & 0x00FF00FFu) +
+                          0x00040004u) >> 3) & 0x00FF00FFu;
+    const uint32_t g = ((((a >> 8) & 0xFFu) + ((b >> 8) & 0xFFu) * 6u + ((c >> 8) & 0xFFu) + 4u) >> 3) & 0xFFu;
+    return 0xFF000000u | rb | (g << 8);
+}
+
+// Suavizado [1 6 1]/8 en horizontal y después en vertical (bordes repetidos).
+inline void suavizar_h(const uint32_t* s, int w, int h, uint32_t* d) {
+    for (int y = 0; y < h; ++y) {
+        const uint32_t* f = s + static_cast<std::size_t>(y) * w;
+        uint32_t* o = d + static_cast<std::size_t>(y) * w;
+        if (w == 1) { o[0] = f[0]; continue; }
+        o[0] = mezcla161(f[0], f[0], f[1]);
+        for (int x = 1; x < w - 1; ++x) o[x] = mezcla161(f[x - 1], f[x], f[x + 1]);
+        o[w - 1] = mezcla161(f[w - 2], f[w - 1], f[w - 1]);
+    }
+}
+
+inline void suavizar_v(const uint32_t* s, int w, int h, uint32_t* d) {
+    for (int y = 0; y < h; ++y) {
+        const uint32_t* a = s + static_cast<std::size_t>(y > 0 ? y - 1 : 0) * w;
+        const uint32_t* b = s + static_cast<std::size_t>(y) * w;
+        const uint32_t* c = s + static_cast<std::size_t>(y < h - 1 ? y + 1 : h - 1) * w;
+        uint32_t* o = d + static_cast<std::size_t>(y) * w;
+        for (int x = 0; x < w; ++x) o[x] = mezcla161(a[x], b[x], c[x]);
+    }
+}
+
+// Cuánto cubre una raya oscura de 'raya' píxeles, situada al final de cada celda de
+// 'celda' píxeles, al píxel de pantalla x (que ocupa [x, x+1)). Es el área exacta:
+// con celdas de tamaño entero cae justo en un píxel y con tamaños fraccionarios no
+// produce moiré.
+inline double cobertura(int x, double celda, double raya) {
+    const auto acumulado = [&](double u) {
+        const double k = std::floor(u / celda);
+        const double resto = u - k * celda;
+        return k * raya + (resto > celda - raya ? resto - (celda - raya) : 0.0);
+    };
+    double c = acumulado(x + 1.0) - acumulado(static_cast<double>(x));
+    return c < 0.0 ? 0.0 : (c > 1.0 ? 1.0 : c);
+}
+
+inline uint32_t gris(double v) {
+    int c = static_cast<int>(v * 255.0 + 0.5);
+    c = c < 0 ? 0 : (c > 255 ? 255 : c);
+    return 0xFF000000u | (static_cast<uint32_t>(c) << 16) | (static_cast<uint32_t>(c) << 8) |
+           static_cast<uint32_t>(c);
+}
+
+}  // namespace detalle
+
+// Tamaño máximo de la máscara (píxeles de ventana): por encima se compone a una
+// resolución menor (ver reduccion_mascara). Componer 1920x1080 cuesta ≈ 6 ms de CPU.
+inline bool mascara_cabe(int dw, int dh) {
+    return dw > 0 && dh > 0 && static_cast<long long>(dw) * dh <= 1920LL * 1080LL;
+}
+
+// Máscara de la rejilla de la pantalla LCD de la GBA para una imagen de dw x dh píxeles
+// de ventana que muestra bw x bh píxeles de juego: cada píxel de juego es una celda con
+// una raya oscura (de 1 píxel, o el 14 % de la celda si es grande) en su lado derecho y
+// en su lado inferior. Devuelve la luminosidad media de la máscara (0..1), o -1 si la
+// ventana es demasiado pequeña (menos de 2 píxeles por píxel de juego) o demasiado grande.
+inline double mascara_lcd(int dw, int dh, int bw, int bh, std::vector<uint32_t>& m) {
+    if (bw < 1 || bh < 1 || dw < 2 * bw || dh < 2 * bh || !mascara_cabe(dw, dh)) return -1.0;
+    const double sx = static_cast<double>(dw) / bw, sy = static_cast<double>(dh) / bh;
+    const double rx = std::fmin(std::fmax(0.14 * sx, 1.0), 0.34 * sx);
+    const double ry = std::fmin(std::fmax(0.14 * sy, 1.0), 0.34 * sy);
+    const double oscuridad = 0.30;   // la raya deja pasar el 70 % de la luz
+    std::vector<double> fx(static_cast<std::size_t>(dw)), fy(static_cast<std::size_t>(dh));
+    double mx = 0.0, my = 0.0;
+    for (int x = 0; x < dw; ++x) { fx[static_cast<std::size_t>(x)] = 1.0 - oscuridad * detalle::cobertura(x, sx, rx); mx += fx[static_cast<std::size_t>(x)]; }
+    for (int y = 0; y < dh; ++y) { fy[static_cast<std::size_t>(y)] = 1.0 - oscuridad * detalle::cobertura(y, sy, ry); my += fy[static_cast<std::size_t>(y)]; }
+    m.resize(static_cast<std::size_t>(dw) * dh);
+    for (int y = 0; y < dh; ++y)
+        for (int x = 0; x < dw; ++x)
+            m[static_cast<std::size_t>(y) * dw + x] =
+                detalle::gris(fx[static_cast<std::size_t>(x)] * fy[static_cast<std::size_t>(y)]);
+    return (mx / dw) * (my / dh);
+}
+
+// Máscara de las líneas de barrido de un CRT: cada línea de la GBA es una franja con el
+// centro del haz a plena luz y los bordes más oscuros (hasta el 45 %). Se promedian 4
+// muestras por fila de ventana, así no hay moiré con tamaños fraccionarios. Devuelve la
+// luminosidad media, o -1 si la ventana es demasiado pequeña (menos de 2 filas por línea)
+// o demasiado grande.
+inline double mascara_crt(int dw, int dh, int bw, int bh, std::vector<uint32_t>& m) {
+    (void)bw;
+    if (bh < 1 || dw < 1 || dh < 2 * bh || !mascara_cabe(dw, dh)) return -1.0;
+    const double sy = static_cast<double>(dh) / bh;
+    const double oscuridad = 0.55;
+    std::vector<uint32_t> fila(static_cast<std::size_t>(dh));
+    double media = 0.0;
+    for (int y = 0; y < dh; ++y) {
+        double acum = 0.0;
+        for (int i = 0; i < 4; ++i) {
+            const double pos = (y + (i + 0.5) / 4.0) / sy;
+            const double p = pos - std::floor(pos);
+            const double t = 2.0 * std::fabs(p - 0.5);          // 0 en el centro, 1 en el borde
+            acum += 1.0 - oscuridad * t * t;
+        }
+        const double v = acum / 4.0;
+        fila[static_cast<std::size_t>(y)] = detalle::gris(v);
+        media += v;
+    }
+    m.resize(static_cast<std::size_t>(dw) * dh);
+    for (int y = 0; y < dh; ++y)
+        for (int x = 0; x < dw; ++x) m[static_cast<std::size_t>(y) * dw + x] = fila[static_cast<std::size_t>(y)];
+    return media / dh;
+}
+
+// La máscara solo oscurece: se compensa parte de lo que quita subiendo el brillo de la
+// imagen de origen (hasta un 40 %); los colores que llegan a 255 se recortan.
+inline double ganancia_mascara(double media) {
+    if (!(media > 0.05) || media >= 1.0) return 1.0;
+    const double g = 1.0 + 0.6 * (1.0 / media - 1.0);
+    return g > 1.4 ? 1.4 : g;
+}
+
+inline void aplicar_ganancia(std::vector<uint32_t>& img, double g) {
+    if (g <= 1.0001) return;
+    const int k = static_cast<int>(g * 256.0 + 0.5);
+    for (uint32_t& p : img) {
+        const int r = (detalle::cr(p) * k + 128) >> 8, gg = (detalle::cg(p) * k + 128) >> 8,
+                  bb = (detalle::cb(p) * k + 128) >> 8;
+        p = detalle::rgb(r, gg, bb);
+    }
+}
+
+// Aplica el filtro 'filtro' (2..8) a 's' (w x h) y deja el resultado en 'd', de
+// (w*N) x (h*N) píxeles con N = escala_total(). Devuelve false si el filtro no genera
+// imagen. 'n_nitido' se usa con los filtros 2, 7 y 8 y 'k_post' con los ampliadores 3..6.
+inline bool aplicar(int filtro, int n_nitido, const uint32_t* s, int w, int h,
+                    std::vector<uint32_t>& d, Buffers& buf, int k_post = 1) {
+    const int n = es_nitido(filtro) ? n_nitido : factor(filtro);
+    if (n < 2 || w < 1 || h < 1) return false;
+    const std::size_t area = static_cast<std::size_t>(w) * h;
+    d.resize(area * n * n);
+    if (es_nitido(filtro)) {
+        detalle::replicar(s, w, h, n, d.data());
+        return true;
+    }
+    switch (filtro) {
+        case kScale2x:
+            detalle::scale2x(s, w, h, d.data());
+            break;
+        case kScale3x:
+            detalle::scale3x(s, w, h, d.data());
+            break;
+        case kScale4x:
+            buf.t1.resize(area * 4);
+            detalle::scale2x(s, w, h, buf.t1.data());
+            detalle::scale2x(buf.t1.data(), w * 2, h * 2, d.data());
+            break;
+        case kHdSuave:
+            buf.t1.resize(area * 16);
+            buf.t2.resize(area * 16);
+            detalle::scale2x(s, w, h, buf.t1.data());
+            detalle::scale2x(buf.t1.data(), w * 2, h * 2, buf.t2.data());
+            detalle::suavizar_h(buf.t2.data(), w * 4, h * 4, buf.t1.data());
+            detalle::suavizar_v(buf.t1.data(), w * 4, h * 4, d.data());
+            break;
+        default:
+            return false;
+    }
+    if (k_post > 1) {
+        // Replicación entera del resultado (ver factor_post): d pasa a buf.t2 y vuelve
+        // ampliada.
+        buf.t2.swap(d);
+        d.resize(area * n * n * k_post * k_post);
+        detalle::replicar(buf.t2.data(), w * n, h * n, k_post, d.data());
+    }
+    return true;
+}
+
+// Nombre del filtro (el mismo que el menú de arranque), para el aviso del título.
+inline const char* nombre(int filtro) {
+    static const char* const n[kTotal] = {
+        "Nearest", "Linear", "Sharp fractional", "Scale2x", "Scale3x",
+        "Scale4x", "HD smooth", "LCD grid (GBA)", "CRT scanlines"};
+    return (filtro >= 0 && filtro < kTotal) ? n[filtro] : "?";
+}
+
+// Las máscaras LCD y CRT se componen por CPU a la resolución de la imagen en pantalla
+// dividida por un entero 'k' (1 casi siempre) para que no pase de 1920x1080 píxeles;
+// después la tarjeta gráfica la estira sin filtro (cada píxel compuesto son k x k de
+// pantalla).
+inline int reduccion_mascara(int dw, int dh) {
+    int k = 1;
+    while (k < 8 && !mascara_cabe(dw / k, dh / k)) ++k;
+    return k;
+}
+
+// Marca las filas de la máscara iguales a la anterior (rep[y] = 1): en la rejilla LCD la
+// mayoría de las filas de una celda son idénticas y 'componer' las copia en vez de
+// recalcularlas.
+inline void filas_repetidas(const uint32_t* m, int dw, int dh, std::vector<uint8_t>& rep) {
+    rep.assign(static_cast<std::size_t>(dh), 0);
+    for (int y = 1; y < dh; ++y)
+        rep[static_cast<std::size_t>(y)] =
+            std::memcmp(m + static_cast<std::size_t>(y) * dw,
+                        m + static_cast<std::size_t>(y - 1) * dw,
+                        static_cast<std::size_t>(dw) * sizeof(uint32_t)) == 0 ? 1 : 0;
+}
+
+// Compone la imagen de origen (bw x bh, un entero ARGB por píxel) con la máscara 'm'
+// (dw x dh, el gris va en el canal azul): cada píxel de salida es el píxel de origen
+// que le cae encima (vecino más cercano, igual que las celdas de la máscara) por el
+// gris de la máscara. 'cols' es una tabla de trabajo; 'rep' (opcional, de
+// filas_repetidas) permite copiar las filas que salen iguales que la anterior.
+inline void componer(const uint32_t* origen, int bw, int bh, const uint32_t* m,
+                     int dw, int dh, std::vector<uint32_t>& out, std::vector<int>& cols,
+                     const std::vector<uint8_t>* rep = nullptr) {
+    out.resize(static_cast<std::size_t>(dw) * dh);
+    cols.resize(static_cast<std::size_t>(dw));
+    for (int x = 0; x < dw; ++x)
+        cols[static_cast<std::size_t>(x)] =
+            static_cast<int>((static_cast<long long>(x) * bw) / dw);
+    int sy_anterior = -1;
+    for (int y = 0; y < dh; ++y) {
+        const int sy = static_cast<int>((static_cast<long long>(y) * bh) / dh);
+        const uint32_t* fila = origen + static_cast<std::size_t>(sy) * bw;
+        const uint32_t* mf = m + static_cast<std::size_t>(y) * dw;
+        uint32_t* d = out.data() + static_cast<std::size_t>(y) * dw;
+        const bool copiar = rep && y > 0 && sy == sy_anterior &&
+                            (*rep)[static_cast<std::size_t>(y)] != 0;
+        sy_anterior = sy;
+        if (copiar) {
+            std::memcpy(d, d - dw, static_cast<std::size_t>(dw) * sizeof(uint32_t));
+            continue;
+        }
+        for (int x = 0; x < dw; ++x) {
+            const uint32_t p = fila[cols[static_cast<std::size_t>(x)]];
+            const uint32_t g = (mf[x] & 0xFFu) + 1u;                    // 1..256
+            const uint32_t rb = (((p & 0x00FF00FFu) * g) >> 8) & 0x00FF00FFu;
+            const uint32_t v = ((((p >> 8) & 0xFFu) * g) >> 8) << 8;      // verde
+            d[x] = 0xFF000000u | rb | (v & 0x0000FF00u);
+        }
+    }
+}
