+// PARCHE mario-tennis: enseña el atajo en español («Alt+Intro», «Mayús+P»). Solo es el
+// texto que se dibuja: lo que se guarda en config.ini sigue siendo «Alt+Return», «Shift+P».
+static const char* etiqueta_atajo(const char* atajo) {
+    static char buf[64];
+    if (!atajo || !atajo[0]) return ui_text("(unbound)");
+    buf[0] = 0;
+    for (;;) {
+        const char* mod = nullptr;
+        size_t largo = 0;
+        if (!strncmp(atajo, "Ctrl+", 5))       { mod = "Ctrl";  largo = 5; }
+        else if (!strncmp(atajo, "Alt+", 4))   { mod = "Alt";   largo = 4; }
+        else if (!strncmp(atajo, "Shift+", 6)) { mod = "Shift"; largo = 6; }
+        if (!mod) break;
+        std::snprintf(buf + strlen(buf), sizeof(buf) - strlen(buf), "%s+", ui_text(mod));
+        atajo += largo;
+    }
+    std::snprintf(buf + strlen(buf), sizeof(buf) - strlen(buf), "%s", ui_text(atajo));
+    return buf;
+}
