+// PARCHE mario-tennis: con MTP_I18N_DEBUG=1 se escribe en stderr cada texto sin traducir (una
+// vez por texto), para encontrar lo que falta en la tabla al recorrer los menús.
+static void avisar_sin_traducir(const char* english) {
+    static const char* activo = std::getenv("MTP_I18N_DEBUG");
+    if (!activo || !activo[0] || !english || !english[0]) return;
+    static unsigned long long vistos[4096];
+    static int n_vistos = 0;
+    unsigned long long h = 1469598103934665603ULL;               // FNV-1a de 64 bits
+    for (const char* c = english; *c; ++c) h = (h ^ (unsigned char)*c) * 1099511628211ULL;
+    for (int i = 0; i < n_vistos; ++i) if (vistos[i] == h) return;
+    if (n_vistos < 4096) vistos[n_vistos++] = h;
+    std::fprintf(stderr, "i18n sin traducir: %s\n", english);
+}
+
