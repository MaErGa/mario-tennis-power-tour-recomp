+// Número de ranura de una fila «Slot N» (0 si la clave no es de ese tipo).
+int mtp_ranura_de_fila(const RecompRuntimeUiItem* item) {
+    const std::size_t n = std::strlen(GBARECOMP_UI_PREFIJO_NOMBRE_ESTADO);
+    if (!item || !item->key || std::strncmp(item->key, GBARECOMP_UI_PREFIJO_NOMBRE_ESTADO, n) != 0)
+        return 0;
+    const int ranura = std::atoi(item->key + n);
+    return ranura >= 1 && ranura <= 10 ? ranura : 0;
+}
