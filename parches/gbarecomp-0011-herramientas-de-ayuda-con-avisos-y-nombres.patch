+// PARCHE mario-tennis: nombres de los estados guardados (0.7.0). Cada ranura puede llevar un
+// nombre puesto por la persona y la fecha del último guardado, en un fichero de dos líneas junto
+// al estado («<estado>.info»: «nombre=…» y «fecha=dd/mm/aaaa hh:mm»). Sin nombre, la ranura enseña
+// la fecha. Es texto plano: se puede abrir, copiar o borrar a mano sin que el estado se estropee.
+struct MtpInfoEstado {
+    std::string nombre;   // puesto por la persona (vacío: se enseña la fecha)
+    std::string fecha;    // fecha del último guardado (vacío: no consta)
+};
+
+[[maybe_unused]] std::string mtp_ruta_info(const std::string& ruta_estado) {
+    return ruta_estado + ".info";
+}
+
+[[maybe_unused]] MtpInfoEstado mtp_leer_info(const std::string& ruta_estado) {
+    MtpInfoEstado r;
+    std::ifstream f(mtp_ruta_info(ruta_estado));
+    std::string linea;
+    while (std::getline(f, linea)) {
+        if (!linea.empty() && linea.back() == '\r') linea.pop_back();
+        const std::size_t igual = linea.find('=');
+        if (igual == std::string::npos) continue;
+        const std::string clave = linea.substr(0, igual);
+        const std::string valor = linea.substr(igual + 1);
+        if (clave == "nombre") r.nombre = valor;
+        else if (clave == "fecha") r.fecha = valor;
+    }
+    return r;
+}
+
+// Sin los caracteres de control, sin espacios en los extremos y como mucho 60 bytes (sin partir
+// un carácter UTF-8 por la mitad).
+[[maybe_unused]] std::string mtp_limpiar_nombre(std::string_view in) {
+    std::string t;
+    for (const char ch : in)
+        t.push_back(static_cast<unsigned char>(ch) < 0x20 || ch == 0x7f ? ' ' : ch);
+    std::size_t ini = 0;
+    while (ini < t.size() && t[ini] == ' ') ++ini;
+    std::size_t fin = t.size();
+    while (fin > ini && t[fin - 1] == ' ') --fin;
+    t = t.substr(ini, fin - ini);
+    if (t.size() > 60) {
+        std::size_t corte = 60;
+        while (corte > 0 && (static_cast<unsigned char>(t[corte]) & 0xC0) == 0x80) --corte;
+        t.resize(corte);
+        while (!t.empty() && t.back() == ' ') t.pop_back();
+    }
+    return t;
+}
+
+[[maybe_unused]] void mtp_escribir_info(const std::string& ruta_estado, const MtpInfoEstado& info) {
+    const std::string ruta = mtp_ruta_info(ruta_estado);
+    std::error_code ec;
+    if (info.nombre.empty() && info.fecha.empty()) {
+        std::filesystem::remove(ruta, ec);
+        return;
+    }
+    std::ofstream f(ruta, std::ios::trunc);
+    if (!f) return;
+    f << "nombre=" << info.nombre << "\n" << "fecha=" << info.fecha << "\n";
+}
+
+[[maybe_unused]] std::string mtp_formato_fecha(std::time_t t) {
+    std::tm tm{};
+#if defined(_WIN32)
+    localtime_s(&tm, &t);
+#else
+    localtime_r(&t, &tm);
+#endif
+    char buf[32];
+    std::strftime(buf, sizeof(buf), "%d/%m/%Y %H:%M", &tm);
+    return buf;
+}
+
+[[maybe_unused]] std::string mtp_fecha_ahora() {
+    return mtp_formato_fecha(std::time(nullptr));
+}
+
+// Fecha que se enseña de un estado: la anotada al guardar o, si no consta (un estado de una versión
+// anterior), la de modificación del fichero. Vacía si el estado no existe.
+[[maybe_unused]] std::string mtp_fecha_de_estado(const std::string& ruta_estado,
+                                                 const MtpInfoEstado& info) {
+    std::error_code ec;
+    if (!std::filesystem::exists(ruta_estado, ec) || ec) return "";
+    if (!info.fecha.empty()) return info.fecha;
+    const auto ft = std::filesystem::last_write_time(ruta_estado, ec);
+    if (ec) return "";
+    const auto sys = std::chrono::time_point_cast<std::chrono::system_clock::duration>(
+        ft - std::filesystem::file_time_type::clock::now() + std::chrono::system_clock::now());
+    return mtp_formato_fecha(std::chrono::system_clock::to_time_t(sys));
+}
+
+// Lo que se enseña de una ranura: su nombre o, sin nombre, la fecha del guardado.
+[[maybe_unused]] std::string mtp_texto_de_estado(const std::string& ruta_estado) {
+    const MtpInfoEstado info = mtp_leer_info(ruta_estado);
+    if (!info.nombre.empty()) return info.nombre;
+    return mtp_fecha_de_estado(ruta_estado, info);
+}
