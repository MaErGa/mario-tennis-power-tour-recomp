+// PARCHE mario-tennis (DPI): factor con el que el anfitrión agranda el menú (io.FontGlobalScale;
+// 1 = 100 %). Las medidas fijas en píxeles de este archivo se multiplican por él, para que el
+// panel crezca igual que el texto. En el modo táctil ya hay su propia escala.
+float factor_escala(bool touch_friendly) {
+    return touch_friendly ? 1.0f : std::max(1.0f, ImGui::GetIO().FontGlobalScale);
+}
+
+// PARCHE mario-tennis: si el texto no cabe en max_w lo recorta con «...» (sin partir un
+// carácter UTF-8), en vez de dejarlo cortado de golpe por el borde o pisando otros controles.
+const char *recortar_a_ancho(const char *texto, float max_w, char *buf, size_t n) {
+    if (!texto || n < 8 || max_w <= 0.0f || ImGui::CalcTextSize(texto).x <= max_w)
+        return texto;
+    size_t largo = std::strlen(texto);
+    if (largo > n - 4) largo = n - 4;
+    while (largo > 0) {
+        --largo;
+        while (largo > 0 && (static_cast<unsigned char>(texto[largo]) & 0xC0) == 0x80) --largo;
+        std::memcpy(buf, texto, largo);
+        std::memcpy(buf + largo, "...", 4);
+        if (ImGui::CalcTextSize(buf).x <= max_w) return buf;
+    }
+    return "...";
+}
