+// ---- Idioma elegido por la persona (PARCHE mario-tennis) ------------------------
+// Orden de prioridad: variable de entorno MTP_IDIOMA_MENU (pruebas) > lo elegido en el
+// selector «Idioma del menú» (config.ini, [Menu] Language = es|en) > el de compilación.
+static char g_idioma_elegido[8] = "";   // «es» o «en»; vacío = aún sin elegir
+static bool g_config_leida = false;
+
+static const char* ruta_config(void) {
+    const char* ruta = std::getenv("MTP_CONFIG_INI");
+    return (ruta && ruta[0]) ? ruta : "config.ini";
+}
+
+static bool igual_sin_mayusculas(const char* a, const char* b) {
+    while (*a && *b && std::tolower((unsigned char)*a) == std::tolower((unsigned char)*b)) {
+        ++a; ++b;
+    }
+    return *a == *b;
+}
+
+static char* recortar(char* texto) {
+    while (*texto && std::isspace((unsigned char)*texto)) ++texto;
+    size_t n = std::strlen(texto);
+    while (n && std::isspace((unsigned char)texto[n - 1])) texto[--n] = '\0';
+    return texto;
+}
+
+static void leer_idioma_de_config(void) {
+    g_config_leida = true;
+    FILE* f = std::fopen(ruta_config(), "rb");
+    if (!f) return;
+    char linea[512];
+    bool en_menu = false;
+    while (std::fgets(linea, sizeof(linea), f)) {
+        char* s = recortar(linea);
+        if (!*s || *s == '#' || *s == ';') continue;
+        if (*s == '[') {
+            char* cierre = std::strchr(s, ']');
+            if (cierre) *cierre = '\0';
+            en_menu = igual_sin_mayusculas(s + 1, "Menu");
+            continue;
+        }
+        if (!en_menu) continue;
+        char* igual = std::strchr(s, '=');
+        if (!igual) continue;
+        *igual = '\0';
+        if (!igual_sin_mayusculas(recortar(s), "Language")) continue;
+        const char* valor = recortar(igual + 1);
+        if (igual_sin_mayusculas(valor, "es")) std::strcpy(g_idioma_elegido, "es");
+        else if (igual_sin_mayusculas(valor, "en")) std::strcpy(g_idioma_elegido, "en");
+    }
+    std::fclose(f);
+}
+
 const char* launcher_i18n_language(void) {
     // MTP_IDIOMA_MENU=en|es fuerza el idioma sin recompilar (pruebas).
     const char* forzado = std::getenv("MTP_IDIOMA_MENU");
     if (forzado && forzado[0]) return forzado;
+    if (!g_config_leida) leer_idioma_de_config();
+    if (g_idioma_elegido[0]) return g_idioma_elegido;
     return RECOMP_UI_LANGUAGE;
 }
 
+int launcher_i18n_menu_language(void) {
+    const char* idioma = launcher_i18n_language();
+    return (idioma && (std::strcmp(idioma, "es") == 0 ||
+                       std::strncmp(idioma, "es-", 3) == 0)) ? 0 : 1;
+}
+
+void launcher_i18n_set_menu_language(int index) {
+    const char* nuevo = index == 0 ? "es" : "en";
+    if (std::strcmp(g_idioma_elegido, nuevo) == 0) return;
+    g_config_leida = true;
+    std::strcpy(g_idioma_elegido, nuevo);
+    launcher_ini_kv_write(ruta_config(), "Menu", "Language", nuevo);
+}
